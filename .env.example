# Flask
FLASK_SECRET_KEY=change-me-to-random-string
FLASK_ENV=development

# Database (Coolify will provide this)
DATABASE_URL=postgresql://user:password@localhost:5432/translations

# Cloudflare R2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=colombian-licenses
R2_PUBLIC_URL=https://YOUR_BUCKET.r2.dev
